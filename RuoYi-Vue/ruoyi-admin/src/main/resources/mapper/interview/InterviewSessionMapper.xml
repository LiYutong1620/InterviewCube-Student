<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.interview.mapper.InterviewSessionMapper">
    
    <resultMap type="InterviewSession" id="InterviewSessionResult">
        <result property="id"    column="id"    />
        <result property="sessionNo"    column="session_no"    />
        <result property="userId"    column="user_id"    />
        <result property="jobProfileId"    column="job_profile_id"    />
        <result property="industry"    column="industry"    />
        <result property="jobName"    column="job_name"    />
        <result property="difficulty"    column="difficulty"    />
        <result property="questionType"    column="question_type"    />
        <result property="totalCount"    column="total_count"    />
        <result property="answeredCount"    column="answered_count"    />
        <result property="status"    column="status"    />
        <result property="score"    column="score"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="duration"    column="duration"    />
        <result property="reportId"    column="report_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectInterviewSessionVo">
        select id, session_no, user_id, job_profile_id, industry, job_name, difficulty, question_type, total_count, answered_count, status, score, start_time, end_time, duration, report_id, del_flag, create_by, create_time, update_by, update_time, remark from interview_session
    </sql>

    <select id="selectInterviewSessionList" parameterType="InterviewSession" resultMap="InterviewSessionResult">
        <include refid="selectInterviewSessionVo"/>
        <where>  
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="sessionNo != null  and sessionNo != ''"> and session_no = #{sessionNo}</if>
            <if test="industry != null  and industry != ''"> and industry = #{industry}</if>
            <if test="jobName != null  and jobName != ''"> and job_name like concat('%', #{jobName}, '%')</if>
            <if test="difficulty != null  and difficulty != ''"> and difficulty = #{difficulty}</if>
            <if test="questionType != null  and questionType != ''"> and question_type = #{questionType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="params.beginStartTime != null and params.beginStartTime != '' and params.endStartTime != null and params.endStartTime != ''"> and start_time between #{params.beginStartTime} and #{params.endStartTime}</if>
            <if test="params.beginEndTime != null and params.beginEndTime != '' and params.endEndTime != null and params.endEndTime != ''"> and end_time between #{params.beginEndTime} and #{params.endEndTime}</if>
        </where>
    </select>
    
    <select id="selectInterviewSessionById" parameterType="Long" resultMap="InterviewSessionResult">
        <include refid="selectInterviewSessionVo"/>
        where id = #{id}
    </select>

    <insert id="insertInterviewSession" parameterType="InterviewSession" useGeneratedKeys="true" keyProperty="id">
        insert into interview_session
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sessionNo != null and sessionNo != ''">session_no,</if>
            user_id,
            <if test="jobProfileId != null">job_profile_id,</if>
            <if test="industry != null">industry,</if>
            <if test="jobName != null">job_name,</if>
            <if test="difficulty != null">difficulty,</if>
            <if test="questionType != null">question_type,</if>
            <if test="totalCount != null">total_count,</if>
            <if test="answeredCount != null">answered_count,</if>
            <if test="status != null">status,</if>
            <if test="score != null">score,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="duration != null">duration,</if>
            <if test="reportId != null">report_id,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sessionNo != null and sessionNo != ''">#{sessionNo},</if>
            #{userId},
            <if test="jobProfileId != null">#{jobProfileId},</if>
            <if test="industry != null">#{industry},</if>
            <if test="jobName != null">#{jobName},</if>
            <if test="difficulty != null">#{difficulty},</if>
            <if test="questionType != null">#{questionType},</if>
            <if test="totalCount != null">#{totalCount},</if>
            <if test="answeredCount != null">#{answeredCount},</if>
            <if test="status != null">#{status},</if>
            <if test="score != null">#{score},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="duration != null">#{duration},</if>
            <if test="reportId != null">#{reportId},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateInterviewSession" parameterType="InterviewSession">
        update interview_session
        <trim prefix="SET" suffixOverrides=",">
            <if test="sessionNo != null and sessionNo != ''">session_no = #{sessionNo},</if>
            <if test="jobProfileId != null">job_profile_id = #{jobProfileId},</if>
            <if test="industry != null">industry = #{industry},</if>
            <if test="jobName != null">job_name = #{jobName},</if>
            <if test="difficulty != null">difficulty = #{difficulty},</if>
            <if test="questionType != null">question_type = #{questionType},</if>
            <if test="totalCount != null">total_count = #{totalCount},</if>
            <if test="answeredCount != null">answered_count = #{answeredCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="score != null">score = #{score},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="duration != null">duration = #{duration},</if>
            <if test="reportId != null">report_id = #{reportId},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteInterviewSessionById" parameterType="Long">
        delete from interview_session where id = #{id}
    </delete>

    <delete id="deleteInterviewSessionByIds" parameterType="String">
        delete from interview_session where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>