<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.interview.mapper.StudentAuthMapper">

    <!-- 按角色标识查角色 ID（只取正常状态、未删除的角色） -->
    <select id="selectRoleIdByKey" resultType="java.lang.Long">
        select role_id
          from sys_role
         where role_key = #{roleKey}
           and status   = '0'
           and del_flag = '0'
         order by role_id
         limit 1
    </select>

</mapper>
